import test from "node:test";
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { PGlite } from "@electric-sql/pglite";

test("To-Do DB: private backlog, CMO-only writes, own-task approvals, tenant isolation and one real status history", async () => {
  const db = new PGlite();
  const id = (group: number, n: number) => `${String(group).padStart(8, "0")}-0000-4000-8000-${String(n).padStart(12, "0")}`;
  const u = (n: number) => id(0, n), w = id(1, 1), w2 = id(1, 2), b1 = id(2, 1), b2 = id(2, 2), c1 = id(3, 1), c2 = id(3, 2), t = (n: number) => id(4, n);
  try {
    await db.exec(`
      create role anon; create role authenticated; create role service_role;
      create schema auth;
      create function auth.uid() returns uuid language sql stable as $$ select nullif(current_setting('request.jwt.claim.sub',true),'')::uuid $$;
      grant usage on schema auth to authenticated;
      create type public.task_status as enum ('backlog','todo','in_progress','review','revision','done');
      create table public.profiles(id uuid primary key,full_name text);
      create table public.workspaces(id uuid primary key);
      create table public.workspace_members(workspace_id uuid,user_id uuid,role text);
      create table public.brands(id uuid primary key,workspace_id uuid,name text);
      create table public.campaigns(id uuid primary key,workspace_id uuid,brand_id uuid,brand text,lifecycle_status text default 'active',timeline_config jsonb default '{"phaseMode":true,"phases":[{"id":"phase-a"}],"taskPhase":{}}');
      create table public.tasks(id uuid primary key,workspace_id uuid,campaign_id uuid,brand_id uuid,title text,status public.task_status default 'todo',priority text,due_date date,content_calendar_type text,assignee_id uuid,created_by uuid,created_at timestamptz default now(),updated_at timestamptz default now());
      create table public.task_assignees(task_id uuid references public.tasks,user_id uuid references public.profiles,primary key(task_id,user_id));
      create function public.is_workspace_member(w uuid) returns boolean language sql security definer set search_path='' as $$ select exists(select 1 from public.workspace_members where workspace_id=w and user_id=auth.uid()) $$;
      create function public.is_workspace_manager(w uuid) returns boolean language sql security definer set search_path='' as $$ select exists(select 1 from public.workspace_members where workspace_id=w and user_id=auth.uid() and role in ('owner','admin')) $$;
      grant select on public.profiles,public.workspace_members,public.campaigns,public.brands to authenticated;
      grant update on public.campaigns to authenticated;
      grant select,insert,update,delete on public.tasks,public.task_assignees to authenticated;
      alter table public.tasks enable row level security;
      alter table public.task_assignees enable row level security;
      create policy legacy_task_read on public.tasks for select to authenticated using(public.is_workspace_member(workspace_id));
      create policy legacy_task_write on public.tasks for all to authenticated using(public.is_workspace_member(workspace_id)) with check(public.is_workspace_member(workspace_id));
      create policy legacy_assignee_read on public.task_assignees for select to authenticated using(exists(select 1 from public.tasks where id=task_id));
      create policy legacy_assignee_write on public.task_assignees for all to authenticated using(exists(select 1 from public.tasks where id=task_id)) with check(exists(select 1 from public.tasks where id=task_id));
      insert into public.workspaces values('${w}'),('${w2}');
      insert into public.profiles values ${[1,2,3,4,5,6].map((n) => `('${u(n)}','User ${n}')`).join(",")};
      insert into public.workspace_members values('${w}','${u(1)}','owner'),('${w}','${u(2)}','admin'),('${w}','${u(3)}','member'),('${w}','${u(4)}','viewer'),('${w2}','${u(5)}','owner'),('${w}','${u(6)}','member');
      insert into public.brands values('${b1}','${w}','Brand A'),('${b2}','${w}','Brand B'),('${id(2,3)}','${w2}','Other brand');
      insert into public.campaigns(id,workspace_id,brand_id,brand) values('${c1}','${w}','${b1}','Brand A'),('${c2}','${w}','${b2}','Brand B'),('${id(3,3)}','${w2}','${id(2,3)}','Other brand');
      insert into public.tasks(id,workspace_id,campaign_id,brand_id,title,status,priority,assignee_id) values ${["todo","backlog","in_progress","review","revision","done"].map((status,n) => `('${t(n+1)}','${w}','${c1}','${b1}','Task ${n+1}','${status}','${n===0?"Tinggi":"Sedang"}','${u(3)}')`).join(",")};
      insert into public.task_assignees(task_id,user_id) select id,'${u(3)}'::uuid from public.tasks;
    `);
    for (const file of ["20261030100000_campaign_overview_and_task_history.sql", "20261030120000_todo_workflow_approvals.sql"]) await db.exec(await readFile(new URL(`../supabase/migrations/${file}`, import.meta.url), "utf8"));
    const login = async (n: number) => { await db.exec("reset role"); await db.query("select set_config('request.jwt.claim.sub',$1,false)", [u(n)]); await db.exec("set role authenticated"); };
    const change = (task: string, patch: object) => db.query("select public.update_marketing_task($1,$2::jsonb)", [task, JSON.stringify(patch)]);
    const request = async (task: string, status: string) => (await db.query<{ request: { id: string } }>("select public.request_task_status($1,$2::public.task_status) as request", [task,status])).rows[0].request.id;
    const decide = (request: string, approve: boolean) => db.query("select public.decide_task_status($1,$2)", [request,approve]);
    const status = async (task: string) => (await db.query<{ status: string }>("select status::text from public.tasks where id=$1", [task])).rows[0]?.status;
    const count = async () => (await db.query<{ count: number }>("select count(*)::int as count from public.task_status_history")).rows[0].count;
    const requestState = async (id: string) => (await db.query<{ state: string }>("select state from public.task_status_requests where id=$1", [id])).rows[0]?.state;

    await login(3);
    assert.equal(await status(t(2)), undefined); // Backlog cannot be fetched directly.
    assert.equal((await db.query("update public.tasks set title='Unauthorized' where id=$1 returning id", [t(1)])).rows.length, 0);
    await assert.rejects(change(t(1), { status: "in_progress" }));
    await assert.rejects(db.query("insert into public.tasks(id,workspace_id,title) values($1,$2,'Denied')", [t(20),w]));
    await assert.rejects(db.query("select public.create_marketing_task($1,$2,$3::jsonb)", [w,t(20),JSON.stringify({title:"Denied",brand_id:b1,due_date:"2026-11-01"})]));
    await assert.rejects(db.query("insert into public.task_assignees values($1,$2)",[t(1),u(6)]));
    const first = await request(t(1), "in_progress");
    assert.equal(await status(t(1)), "todo"); assert.equal(await count(), 0);
    await assert.rejects(request(t(1), "in_progress")); await assert.rejects(request(t(3), "done")); await assert.rejects(request(t(2), "todo"));
    await assert.rejects(db.query("update public.task_status_requests set state='approved' where id=$1",[first]));
    await assert.rejects(decide(first,true));
    await login(6); await assert.rejects(request(t(3),"review"));
    await login(4); await assert.rejects(request(t(3),"review")); assert.equal(await status(t(2)),undefined);
    await login(5); await assert.rejects(request(t(1),"in_progress")); await assert.rejects(decide(first,true)); assert.equal((await db.query("select * from public.task_status_requests")).rows.length,0);
    await login(1); assert.equal(await status(t(2)),"backlog"); await decide(first,true); assert.equal(await status(t(1)),"in_progress"); assert.equal(await count(),1); assert.equal(await requestState(first),"approved"); await assert.rejects(decide(first,true)); assert.equal(await count(),1);
    assert.equal((await db.query<{ actor_id: string }>("select actor_id from public.task_status_history")).rows[0].actor_id,u(1));
    await login(3); const second = await request(t(1),"review");
    await login(2); await decide(second,false); assert.equal(await status(t(1)),"in_progress"); assert.equal(await count(),1); assert.equal(await requestState(second),"rejected");
    await login(3); const third = await request(t(1),"review");
    await login(1); await change(t(1),{status:"done"}); assert.equal(await requestState(third),"cancelled"); await assert.rejects(decide(third,true));
    await login(3); const revision = await request(t(5),"in_progress");
    await login(2); await decide(revision,true); assert.equal(await status(t(5)),"in_progress");
    await login(3); const unassigned = await request(t(3),"review");
    await login(1); await change(t(3),{assignee_ids:[u(6)]}); assert.equal(await requestState(unassigned),"cancelled");
    await assert.rejects(change(t(1),{campaign_id:c2,brand_id:b1}));
    await assert.rejects(change(t(1),{campaign_id:id(3,3)}));
    await change(t(1),{campaign_id:c2,brand_id:b2,is_priority:false,content_calendar_type:"reels",due_date:"2026-11-02",title:"Moved campaign"});
    const moved=(await db.query<{campaign_id:string;brand_id:string;is_priority:boolean;priority:string}>("select * from public.tasks where id=$1",[t(1)])).rows[0];
    assert.equal(moved.campaign_id,c2); assert.equal(moved.brand_id,b2); assert.equal(moved.is_priority,false); assert.equal(moved.priority,"Rendah");
    const beforeCreate=await count();
    await db.query("select public.create_marketing_task($1,$2,$3::jsonb)",[w,t(20),JSON.stringify({title:"New campaign task",campaign_id:c2,brand_id:b2,due_date:"2026-11-01",status:"todo",is_priority:true,assignee_ids:[u(6)]})]);
    assert.equal(await status(t(20)),"todo"); assert.equal(await count(),beforeCreate); assert.equal((await db.query<{is_priority:boolean}>("select is_priority from public.tasks where id=$1",[t(20)])).rows[0].is_priority,true);
    await change(t(4),{status:"backlog"});
    await login(3); assert.equal((await db.query("select * from public.task_status_history where task_id=$1",[t(4)])).rows.length,0);
    await login(1);
    await db.exec("reset role"); await db.query("update public.campaigns set lifecycle_status='archived' where id=$1",[c2]);
    await login(1); await assert.rejects(change(t(20),{status:"done"}));
    await login(6); await assert.rejects(request(t(20),"in_progress"));
  } finally { await db.close(); }
});
